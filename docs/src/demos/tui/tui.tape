# Run from the repository root with Finch, VHS, ttyd, ffmpeg, and Chrome installed.
# The SSP and mappings in this demo are fictional.
Output docs/src/content/user-guide/assets/tui.gif

Set Shell "bash"
Set Theme "Dracula"
Set FontSize 18
Set Width 1400
Set Height 800
Set TypingSpeed 30ms

Type "finch start tui --ssp docs/src/demos/tui/tui-ssp.json"
Enter
Sleep 2s
Enter
Sleep 1s
Enter
Sleep 1s
Enter
Sleep 1s
Enter
Sleep 1s
Space
Sleep 1s
Enter
Sleep 1s
Enter
Sleep 1s
Down
Down
Down
Down
Down
Space
Sleep 2s
Enter
Sleep 1s
Enter
Sleep 1s
Type "The gateway filters these requests before forwarding them."
Enter
Sleep 1s
Type "2027-11-25"
Enter
Sleep 1s
Type "n"
Enter
Sleep 1s
Backspace 13
Type "/tmp/finch-tui-demo.yaml"
Enter
Sleep 3s
Ctrl+C
Sleep 1s
